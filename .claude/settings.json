{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./.env.staging)",
      "Read(./.env.ci)",
      "Read(./.env.qa)",
      "Read(./.envrc)",
      "Read(./.env-production)",
      "Read(./secrets/**)",
      "Bash(cat .env*)",
      "Bash(cat *.env*)",
      "Bash(sed *.env*)",
      "Bash(grep *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)"
    ]
  }
}
