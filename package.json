{
  "name": "polyexam-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract": "orval --config orval.config.ts",
    "contract:check": "npm run contract && node scripts/check-contract-drift.mjs",
    "contract:lint": "redocly lint contracts/public.openapi.yaml",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:fast": "npm run lint && npm run typecheck && npm run test",
    "verify:full": "npm run verify && npm run contract:check && npm run e2e"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.82.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "msw": "^3.0.7",
    "orval": "^8.48.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
