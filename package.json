    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.82.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "msw": "^3.0.7",
    "orval": "^8.48.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
