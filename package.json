{
  "name": "polyexam-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract": "orval --config orval.config.ts",
    "contract:check": "npm run contract && node scripts/check-contract-drift.mjs",
    "contract:lint": "redocly lint contracts/public.openapi.yaml",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "check:msw": "node scripts/check-msw-worker.mjs",
    "check:env": "node scripts/check-env-files.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "verify": "npm run verify:fast && npm run build",
    "verify:fast": "npm run format:check && npm run docs:check && npm run check:msw && npm run check:env && npm run check:skills && npm run lint && npm run typecheck && npm run test",
    "verify:full": "npm run verify && npm run contract:check && npm run e2e",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.82.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "next-devtools-mcp": "^0.4.0",
    "orval": "^8.49.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "^7",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
