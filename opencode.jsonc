{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "npm run *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "npm ci *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/*", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git fetch *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },

    { "action": "shell", "resource": "cat *env*", "effect": "deny" },
    { "action": "shell", "resource": "sed *env*", "effect": "deny" },
    { "action": "shell", "resource": "grep *env*", "effect": "deny" },
    { "action": "shell", "resource": "head *env*", "effect": "deny" },
    { "action": "shell", "resource": "tail *env*", "effect": "deny" },
    { "action": "shell", "resource": "less *env*", "effect": "deny" },
    { "action": "shell", "resource": "more *env*", "effect": "deny" },
    { "action": "shell", "resource": "strings *env*", "effect": "deny" },
    { "action": "shell", "resource": "xxd *env*", "effect": "deny" },
    { "action": "shell", "resource": "od *env*", "effect": "deny" },

    { "action": "shell", "resource": "git push *force*", "effect": "deny" },
    { "action": "shell", "resource": "git push *-f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * main", "effect": "deny" },
    { "action": "shell", "resource": "git push * main:*", "effect": "deny" },
    { "action": "shell", "resource": "git push * HEAD:main", "effect": "deny" },
    { "action": "shell", "resource": "git push * :main", "effect": "deny" },
    { "action": "shell", "resource": "git push *no-verify*", "effect": "deny" },
    {
      "action": "shell",
      "resource": "git commit *no-verify*",
      "effect": "deny",
    },
    { "action": "shell", "resource": "git commit *-n*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "git clean -*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
  ],
}
