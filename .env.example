# Public frontend configuration.
# Only NEXT_PUBLIC_* values are exposed to the browser. Never put backend
# secrets, payment keys, or student data in this repository.

NEXT_PUBLIC_APP_NAME=PolyExam
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Server-only values used by the future BFF. Keep placeholders only.
API_BASE_URL=http://localhost:8000/api
SESSION_SECRET=replace-with-a-long-random-value
